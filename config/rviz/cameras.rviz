Panels:
  - Class: wc_camera_panel/CameraPanel
    Name: 四摄像头
    Mapping Status: USER_CONFIRMED
    left_front USB Port: 1
    right_front USB Port: 4
    left_side USB Port: 2
    right_side USB Port: 3
Visualization Manager:
  Class: ""
  Enabled: true
  Name: root
  Global Options:
    Background Color: 24; 29; 36
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Reference grid - not a measured map
      Enabled: true
      Value: true
      Plane: XY
      Cell Size: 1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/PointCloud2
      Name: Saved or live accumulated 3D map
      Enabled: true
      Value: true
      Alpha: 1
      Color Transformer: AxisColor
      Axis: Z
      Position Transformer: XYZ
      Style: Points
      Size (Pixels): 2
      Decay Time: 0
      Topic:
        Value: /wc_mapping/map/cloud
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 8
      Pitch: 0.65
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Target Frame: <Fixed Frame>
    Saved: []
Window Geometry:
  Width: 1800
  Height: 1000
  Hide Left Dock: false
  Hide Right Dock: false
