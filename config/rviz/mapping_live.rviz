# The controller remaps /tf and /tf_static to /wc_mapping/app/{tf,tf_static}.
# Both maps are experimental products, not an accepted navigation map.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Enabled: true
  Name: root
  Global Options:
    Background Color: 24; 29; 36
    Fixed Frame: mapping_map
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/PointCloud2
      Name: 累计三维地图
      Enabled: true
      Value: true
      Alpha: 1
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Value Bounds:
        Value: true
      Position Transformer: XYZ
      Style: Points
      Size (Pixels): 2
      Size (m): 0.03
      Decay Time: 0
      Use Fixed Frame: true
      Topic:
        Value: /wc_mapping/app/cloud_map
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Map
      Name: 二维地图
      Enabled: true
      Value: true
      Alpha: 0.55
      Color Scheme: map
      Draw Behind: true
      Use Timestamp: false
      Topic:
        Value: /wc_mapping/app/view_grid
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/PointCloud2
      Name: 实时点云（当前帧）
      Enabled: true
      Value: true
      Alpha: 0.65
      Color Transformer: FlatColor
      Color: 255; 120; 210
      Position Transformer: XYZ
      Style: Points
      Size (Pixels): 2
      Size (m): 0.03
      Decay Time: 0
      Use Fixed Frame: true
      Topic:
        Value: /wc_mapping/app/scan_cloud
        Depth: 2
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Odometry
      Name: ICP odometry
      Enabled: true
      Value: true
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Keep: 200
      Shape:
        Value: Arrow
        Color: 255; 170; 40
        Alpha: 0.9
        Shaft Length: 0.18
        Shaft Radius: 0.012
        Head Length: 0.07
        Head Radius: 0.025
      Covariance:
        Value: false
      Topic:
        Value: /wc_mapping/app/odom
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Odometry
      Name: Wheel and IMU motion prediction
      Enabled: true
      Value: true
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Keep: 200
      Shape:
        Value: Arrow
        Color: 85; 145; 255
        Alpha: 0.7
        Shaft Length: 0.14
        Shaft Radius: 0.01
        Head Length: 0.06
        Head Radius: 0.02
      Covariance:
        Value: false
      Topic:
        Value: /wc_mapping/app/prior_odom
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Path
      Name: Optimized trajectory
      Enabled: true
      Value: true
      Alpha: 1
      Color: 245; 215; 70
      Buffer Length: 1
      Line Style: Lines
      Line Width: 0.035
      Pose Style: None
      Topic:
        Value: /wc_mapping/app/mapPath
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/MarkerArray
      Name: Input and mapping status
      Enabled: true
      Value: true
      Topic:
        Value: /wc_mapping/app/status_markers
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/MarkerArray
      Name: Wheelchair schematic and sensor locations
      Enabled: true
      Value: true
      Topic:
        Value: /wc_mapping/app/view_markers
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/TF
      Name: Published coordinate frames
      Enabled: true
      Value: true
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Marker Scale: 0.35
      Frame Timeout: 10
      Frames:
        All Enabled: true
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 10
      Pitch: 0.65
      Yaw: 0.8
      Focal Point:
        X: 2
        Y: 0
        Z: 0
      Target Frame: <Fixed Frame>
      Near Clip Distance: 0.01
    Saved:
      - Class: rviz_default_plugins/Orbit
        Name: 3D oblique
        Distance: 10
        Pitch: 0.65
        Yaw: 0.8
        Focal Point:
          X: 2
          Y: 0
          Z: 0
        Target Frame: <Fixed Frame>
        Near Clip Distance: 0.01
      - Class: rviz_default_plugins/TopDownOrtho
        Name: 2D top view
        Angle: 0
        Scale: 60
        X: 2
        Y: 0
        Target Frame: <Fixed Frame>
        Near Clip Distance: 0.01
Window Geometry:
  Width: 1400
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
