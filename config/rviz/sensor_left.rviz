Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Enabled: true
  Name: root
  Global Options:
    Background Color: 24; 29; 36
    Fixed Frame: lidar_left
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/PointCloud2
      Name: left filtered single frame
      Enabled: true
      Value: true
      Alpha: 1
      Color Transformer: AxisColor
      Axis: X
      Position Transformer: XYZ
      Style: Points
      Size (Pixels): 3
      Size (m): 0.02
      Decay Time: 0
      Topic:
        Value: /wc_mapping/lidar_left/points_filtered
        Depth: 2
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
    - Class: rviz_default_plugins/PointCloud2
      Name: left raw single frame
      Enabled: false
      Value: false
      Alpha: 1
      Color Transformer: AxisColor
      Axis: X
      Position Transformer: XYZ
      Style: Points
      Size (Pixels): 3
      Size (m): 0.02
      Decay Time: 0
      Topic:
        Value: /wc_mapping/lidar_left/points_raw
        Depth: 2
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5
      Focal Point:
        X: 2
        Y: 0
        Z: 0
      Pitch: 0.3
      Yaw: 3.14
Window Geometry:
  Width: 1280
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
