#!/usr/bin/env bash
# Pure numerical scenarios; no ROS, sensor drivers, controller or device access.
set -euo pipefail
DYNAMIC_PROJECT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
export PYTHONPATH="$DYNAMIC_PROJECT/src:${PYTHONPATH:-}"
export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1
export OPENBLAS_NUM_THREADS=2 OMP_NUM_THREADS=2
exec /usr/bin/python3 -B -s -m wc_navigation.dynamic_cli --project-root "$DYNAMIC_PROJECT" "$@"
