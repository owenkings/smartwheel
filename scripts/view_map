#!/usr/bin/env python3
"""Open a saved native map without sourcing a Python/ROS shell first."""
from pathlib import Path
import os
import sys

PROJECT = Path('/home/nvidia/wheelchair')
os.environ['PYTHONNOUSERSITE'] = '1'
if not sys.flags.no_user_site:
    os.execv(sys.executable, [sys.executable, '-s', __file__, *sys.argv[1:]])
sys.path.insert(0, str(PROJECT/'src'))

from wc_runtime.map_viewer import main


if __name__ == '__main__':
    raise SystemExit(main(project_root=PROJECT))
