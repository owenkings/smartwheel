#!/usr/bin/env python3
"""Create a development task record on configured storage."""
from pathlib import Path
import sys

sys.dont_write_bytecode = True
for root in Path(__file__).resolve().parents:
    if (root / 'src/wc_runtime').is_dir() and (root / 'config').is_dir():
        sys.path.insert(0, str(root / 'src'))
        break
else:
    raise RuntimeError('Cannot locate the project source and configuration')
from wc_runtime.development_archive import main
raise SystemExit(main())
