#!/usr/bin/env python3
"""Resume an explicitly marked temporary session's map save decision."""
from pathlib import Path
import os
import sys

PROJECT = Path('/home/nvidia/wheelchair')
os.environ['PYTHONNOUSERSITE'] = '1'
if not sys.flags.no_user_site:
    os.execv(sys.executable, [sys.executable, '-s', __file__, *sys.argv[1:]])
sys.path.insert(0, str(PROJECT / 'src'))

from wc_runtime.map_save_app import main


if __name__ == '__main__':
    os.chdir(PROJECT)
    # The save backend sources ROS and this project's install for native export.
    sys.exit(main(project_root=PROJECT))
