# ROS2 build artifacts
build/
install/
log/
.ros/

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
*.egg

# pytest
.pytest_cache/
pytest-of-*/
.coverage
htmlcov/

# rosbag
bags/
/experiments/
*.db3
*.mcap

# Maps - ignore generated maps/artifacts; keep dir placeholder + version manifest
maps/*
!maps/.gitkeep
!maps/map_versions.json

# Backups and compiled shared objects (rebuild from source; never commit blobs)
*.bak*
*.so

# IDE / AI agents
.vscode/
.idea/
.agents/
.codex/
.vscode-test/
*.code-workspace
*.swp
*.swo
*~

# Local scratch files kept at repo root during bringup/debugging
/.*.log
/.*.txt
/.*.py

# OS
.DS_Store
Thumbs.db

# Secrets / device config overrides
*.env
local_config.yaml

# Vendor SDK (too large, install separately)
xtsdk_py/

# Vendored third-party SLAM source (large, with nested .git). Reproduce from the
# documented URL + commit hash + patches/ (see docs/fastlio_mapping.md). FAST-LIO
# at commit 2fffc57; apply patches/apply_fastlio_patches.sh after clone.
src/third_party/

# XT-M60 logs
xtlog/

# doc
docs/camera_snapshots
docs/*.png

# Vendor host program (XT-Toffuture) - large, not source
tools/*
# ...but keep version-controlled off-ground hardware test scripts
!tools/hardware_bringup/

# raw calibration captures (keep the .yaml, not the image tarball)
calib/*.tar.gz

# auto_test: keep only templates and README
auto_test/*
!auto_test/README.md
!auto_test/templates/
!auto_test/templates/**
