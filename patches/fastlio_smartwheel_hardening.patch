diff --git a/include/wheel_velocity_update.hpp b/include/wheel_velocity_update.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..ecc413af84ecfcc4b417dc6dcddd968a74c7f384
--- /dev/null
+++ b/include/wheel_velocity_update.hpp
@@ -0,0 +1,160 @@
+#ifndef FAST_LIO_WHEEL_VELOCITY_UPDATE_HPP
+#define FAST_LIO_WHEEL_VELOCITY_UPDATE_HPP
+
+#include <Eigen/Core>
+#include <Eigen/Cholesky>
+#include <Eigen/Geometry>
+#include <cmath>
+#include <algorithm>
+#include <limits>
+
+// A scalar, measured wheel-forward velocity constraint. This header deliberately
+// has no ROS dependency: timestamp, frame, feedback-health and duplicate-sample
+// gates belong to the caller. Never pass commanded or accumulated wheel pose.
+namespace fast_lio_wheel {
+
+struct Limits {
+  double max_abs_innovation_mps = 0.5;
+  double max_nis = 9.0;
+  double max_velocity_correction_mps = 0.1;
+};
+
+enum class Status {
+  accepted, invalid_input, invalid_covariance, innovation_limit,
+  nis_limit, correction_limit
+};
+
+inline const char *status_name(Status status) {
+  switch (status) {
+    case Status::accepted: return "accepted";
+    case Status::invalid_input: return "invalid_input";
+    case Status::invalid_covariance: return "invalid_covariance";
+    case Status::innovation_limit: return "innovation_limit";
+    case Status::nis_limit: return "nis_limit";
+    case Status::correction_limit: return "correction_limit";
+  }
+  return "unknown";
+}
+
+inline Eigen::Matrix3d skew(const Eigen::Vector3d &v) {
+  Eigen::Matrix3d result;
+  result << 0.0, -v.z(), v.y(), v.z(), 0.0, -v.x(), -v.y(), v.x(), 0.0;
+  return result;
+}
+
+inline bool is_rotation(const Eigen::Matrix3d &r) {
+  return r.allFinite() && std::abs(r.determinant() - 1.0) < 1.0e-6 &&
+      (r.transpose() * r - Eigen::Matrix3d::Identity()).norm() < 1.0e-6;
+}
+
+template<int N>
+struct Result {
+  Status status = Status::invalid_input;
+  double predicted_mps = std::numeric_limits<double>::quiet_NaN();
+  double innovation_mps = std::numeric_limits<double>::quiet_NaN();
+  double innovation_variance = std::numeric_limits<double>::quiet_NaN();
+  double nis = std::numeric_limits<double>::quiet_NaN();
+  double velocity_correction_mps = 0.0;
+  Eigen::Matrix<double, N, 1> delta = Eigen::Matrix<double, N, 1>::Zero();
+  Eigen::Matrix<double, N, N> covariance;
+  Eigen::Matrix<double, 1, N> jacobian = Eigen::Matrix<double, 1, N>::Zero();
+  bool accepted() const { return status == Status::accepted; }
+};
+
+// R_WI rotates IMU vectors to world; R_BI rotates IMU vectors to base_link.
+// t_BI is the IMU-origin position expressed in base_link, NOT its inverse.
+// v_WI is the world velocity of the IMU origin; gyro and gyro_bias are in I.
+// R_WI uses the FAST-LIO right perturbation R * Exp(delta_theta).
+// State tangent order: pos 0, rot 3, extr_R 6, extr_T 9, vel 12, bg 15,
+// ba 18, gravity 21 (S2 has two tangent coordinates, so usual N is 23).
+template<int N>
+Result<N> update_forward_velocity(
+    const Eigen::Matrix3d &R_WI, const Eigen::Vector3d &v_WI,
+    const Eigen::Vector3d &gyro_bias, const Eigen::Vector3d &gyro,
+    const Eigen::Matrix3d &R_BI, const Eigen::Vector3d &t_BI,
+    double measured_forward_mps, double measurement_variance,
+    const Eigen::Matrix<double, N, N> &prior, const Limits &limits = Limits{}) {
+  static_assert(N >= 18, "FAST-LIO velocity and gyro-bias blocks required");
+  Result<N> out;
+  out.covariance = prior;  // A rejected observation is exactly a no-op.
+  if (!is_rotation(R_WI) || !is_rotation(R_BI) || !v_WI.allFinite() ||
+      !gyro_bias.allFinite() || !gyro.allFinite() || !t_BI.allFinite() ||
+      !std::isfinite(measured_forward_mps) ||
+      !std::isfinite(measurement_variance) || measurement_variance <= 0.0 ||
+      !std::isfinite(limits.max_abs_innovation_mps) || limits.max_abs_innovation_mps <= 0.0 ||
+      !std::isfinite(limits.max_nis) || limits.max_nis <= 0.0 ||
+      !std::isfinite(limits.max_velocity_correction_mps) || limits.max_velocity_correction_mps <= 0.0) {
+    return out;
+  }
+  const double covariance_scale = std::max(1.0, prior.cwiseAbs().maxCoeff());
+  if (!prior.allFinite() ||
+      (prior - prior.transpose()).cwiseAbs().maxCoeff() > 1.0e-8 * covariance_scale) {
+    out.status = Status::invalid_covariance;
+    return out;
+  }
+  const Eigen::Matrix<double, N, N> P = 0.5 * (prior + prior.transpose());
+  const Eigen::LDLT<Eigen::Matrix<double, N, N>> prior_ldlt(P);
+  if (prior_ldlt.info() != Eigen::Success ||
+      prior_ldlt.vectorD().minCoeff() < -1.0e-12 * covariance_scale) {
+    out.status = Status::invalid_covariance;
+    return out;
+  }
+
+  const Eigen::Vector3d v_I = R_WI.transpose() * v_WI;
+  const Eigen::Vector3d lever_I = R_BI.transpose() * t_BI;
+  const Eigen::RowVector3d forward_I = R_BI.row(0);
+  out.predicted_mps = (forward_I *
+      (v_I - (gyro - gyro_bias).cross(lever_I)))(0);
+  out.innovation_mps = measured_forward_mps - out.predicted_mps;
+  out.jacobian.template block<1, 3>(0, 3) = forward_I * skew(v_I);
+  out.jacobian.template block<1, 3>(0, 12) = forward_I * R_WI.transpose();
+  out.jacobian.template block<1, 3>(0, 15) = -forward_I * skew(lever_I);
+  out.innovation_variance = (out.jacobian * P * out.jacobian.transpose())(0) +
+      measurement_variance;
+  if (!std::isfinite(out.innovation_variance) || out.innovation_variance <= 0.0 ||
+      !std::isfinite(out.innovation_mps)) {
+    out.status = Status::invalid_covariance;
+    return out;
+  }
+  out.nis = out.innovation_mps * out.innovation_mps / out.innovation_variance;
+  if (std::abs(out.innovation_mps) > limits.max_abs_innovation_mps) {
+    out.status = Status::innovation_limit;
+    return out;
+  }
+  if (!std::isfinite(out.nis) || out.nis > limits.max_nis) {
+    out.status = Status::nis_limit;
+    return out;
+  }
+
+  // Schmidt-style constrained gain: velocity is the active state; position,
+  // orientation, IMU biases, gravity and LiDAR extrinsics stay frozen here.
+  // Retain their Jacobians and cross-covariances so their uncertainty still
+  // contributes to innovation variance. Do NOT zero H_rot/H_bg to over-trust
+  // wheels, and do not use the optimal-gain-only P=(I-KH)P shortcut.
+  Eigen::Matrix<double, N, 1> gain = Eigen::Matrix<double, N, 1>::Zero();
+  gain.template segment<3>(12) =
+      (P.template block<3, N>(12, 0) * out.jacobian.transpose()) /
+      out.innovation_variance;
+  const Eigen::Vector3d delta_velocity = gain.template segment<3>(12) * out.innovation_mps;
+  out.velocity_correction_mps = delta_velocity.norm();
+  if (!delta_velocity.allFinite() ||
+      out.velocity_correction_mps > limits.max_velocity_correction_mps) {
+    out.status = Status::correction_limit;
+    return out;
+  }
+  const Eigen::Matrix<double, N, N> A =
+      Eigen::Matrix<double, N, N>::Identity() - gain * out.jacobian;
+  const Eigen::Matrix<double, N, N> posterior =
+      A * P * A.transpose() + measurement_variance * gain * gain.transpose();
+  if (!posterior.allFinite()) {
+    out.status = Status::invalid_covariance;
+    return out;
+  }
+  out.delta.template segment<3>(12) = delta_velocity;
+  out.covariance = 0.5 * (posterior + posterior.transpose());
+  out.status = Status::accepted;
+  return out;
+}
+
+}  // namespace fast_lio_wheel
+#endif
diff --git a/tests/test_wheel_velocity_update.cpp b/tests/test_wheel_velocity_update.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f843eb5773417a5296b7e79721f8e24a4856a0b6
--- /dev/null
+++ b/tests/test_wheel_velocity_update.cpp
@@ -0,0 +1,143 @@
+#include "wheel_velocity_update.hpp"
+#include <Eigen/Eigenvalues>
+#include <cassert>
+#include <iostream>
+#include <random>
+
+using namespace fast_lio_wheel;
+constexpr int N = 23;
+using Mat = Eigen::Matrix<double, N, N>;
+using Vec = Eigen::Vector3d;
+using Rot = Eigen::Matrix3d;
+const Rot I = Rot::Identity();
+const Vec Z = Vec::Zero();
+const Mat P = Mat::Identity() * 0.01;
+Limits generous() { return Limits{100.0, 1.0e10, 100.0}; }
+double predict(const Rot &r, const Vec &v, const Vec &bg, const Vec &gyro,
+               const Rot &rbi, const Vec &t) {
+  return update_forward_velocity<N>(r, v, bg, gyro, rbi, t, 0.0, 0.01, P,
+      generous()).predicted_mps;
+}
+void expect_noop(const Result<N> &out, const Mat &prior) {
+  assert(!out.accepted());
+  assert(out.delta.isZero(0.0));
+  assert((out.covariance - prior).isZero(0.0));
+}
+int main() {
+  int checks = 0;
+  // 1. Straight travel changes only forward velocity, not pose/attitude.
+  auto straight = update_forward_velocity<N>(I, Z, Z, Z, I, Z, 0.1, 0.01, P);
+  assert(straight.accepted());
+  assert(std::abs(straight.delta(12) - 0.05) < 1e-12);
+  for (int i = 0; i < N; ++i) if (i != 12) assert(straight.delta(i) == 0.0);
+  ++checks;
+
+  // 2. Forward axis rotates with the chassis: yaw=90deg -> world +Y.
+  const Rot yaw = Eigen::AngleAxisd(1.5707963267948966, Vec::UnitZ()).toRotationMatrix();
+  auto turned = update_forward_velocity<N>(yaw, Z, Z, Z, I, Z, 0.1, 0.01, P);
+  assert(turned.accepted() && std::abs(turned.delta(13) - 0.05) < 1e-12);
+  assert(std::abs(turned.delta(12)) < 1e-12);
+  ++checks;
+
+  // 3. Reversing keeps its sign.
+  auto reverse = update_forward_velocity<N>(I, Z, Z, Z, I, Z, -0.1, 0.01, P);
+  assert(reverse.accepted() && reverse.delta(12) < 0.0);
+  ++checks;
+
+  // 4. Rotation about base origin must not appear as forward motion at IMU.
+  const Vec lever(0.15, 0.20, 0.45), gyro(0.0, 0.0, 0.6);
+  assert(std::abs(predict(I, gyro.cross(lever), Z, gyro, I, lever)) < 1e-12);
+  ++checks;
+
+  // 5. Every nonzero Jacobian block matches numerical right-boxplus derivatives.
+  const Rot r = (Eigen::AngleAxisd(0.30, Vec::UnitX()) *
+      Eigen::AngleAxisd(-0.40, Vec::UnitY()) *
+      Eigen::AngleAxisd(0.60, Vec::UnitZ())).toRotationMatrix();
+  const Rot rbi = (Eigen::AngleAxisd(-0.10, Vec::UnitX()) *
+      Eigen::AngleAxisd(0.08, Vec::UnitY())).toRotationMatrix();
+  const Vec v(0.35, -0.12, 0.06), bg(0.001, -0.002, 0.004);
+  const auto model = update_forward_velocity<N>(r, v, bg, gyro, rbi, lever,
+      0.0, 0.01, P, generous());
+  const double eps = 1e-6;
+  for (int axis = 0; axis < 3; ++axis) {
+    const Vec e = Vec::Unit(axis);
+    const Rot plus = r * Eigen::AngleAxisd(eps, e).toRotationMatrix();
+    const Rot minus = r * Eigen::AngleAxisd(-eps, e).toRotationMatrix();
+    const double jrot = (predict(plus, v, bg, gyro, rbi, lever) -
+        predict(minus, v, bg, gyro, rbi, lever)) / (2.0 * eps);
+    const double jvel = (predict(r, v + eps * e, bg, gyro, rbi, lever) -
+        predict(r, v - eps * e, bg, gyro, rbi, lever)) / (2.0 * eps);
+    const double jbias = (predict(r, v, bg + eps * e, gyro, rbi, lever) -
+        predict(r, v, bg - eps * e, gyro, rbi, lever)) / (2.0 * eps);
+    assert(std::abs(jrot - model.jacobian(3 + axis)) < 1e-8);
+    assert(std::abs(jvel - model.jacobian(12 + axis)) < 1e-8);
+    assert(std::abs(jbias - model.jacobian(15 + axis)) < 1e-8);
+  }
+  ++checks;
+
+  // 6. Gates fail closed with no state or covariance mutation.
+  auto reject = update_forward_velocity<N>(I, Z, Z, Z, I, Z, 1.0, 0.01, P);
+  assert(reject.status == Status::innovation_limit); expect_noop(reject, P);
+  reject = update_forward_velocity<N>(I, Z, Z, Z, I, Z, 0.4, 0.0001, P * 0.01);
+  assert(reject.status == Status::nis_limit); expect_noop(reject, P * 0.01);
+  reject = update_forward_velocity<N>(I, Z, Z, Z, I, Z, 0.2, 0.001, P, generous());
+  assert(reject.accepted());
+  Limits tight = generous(); tight.max_velocity_correction_mps = 0.01;
+  reject = update_forward_velocity<N>(I, Z, Z, Z, I, Z, 0.2, 0.001, P, tight);
+  assert(reject.status == Status::correction_limit); expect_noop(reject, P);
+  ++checks;
+
+  // 7. Invalid variance, non-SO3 transforms, nonfinite data and bad P reject.
+  for (double variance : {0.0, -1.0, std::numeric_limits<double>::quiet_NaN()}) {
+    reject = update_forward_velocity<N>(I, Z, Z, Z, I, Z, 0.1, variance, P);
+    assert(reject.status == Status::invalid_input); expect_noop(reject, P);
+  }
+  reject = update_forward_velocity<N>(I * 2.0, Z, Z, Z, I, Z, 0.1, 0.01, P);
+  assert(reject.status == Status::invalid_input); expect_noop(reject, P);
+  Vec bad_v = Z; bad_v.x() = std::numeric_limits<double>::infinity();
+  reject = update_forward_velocity<N>(I, bad_v, Z, Z, I, Z, 0.1, 0.01, P);
+  assert(reject.status == Status::invalid_input); expect_noop(reject, P);
+  Mat bad_P = P; bad_P(0, 0) = -1.0;
+  reject = update_forward_velocity<N>(I, Z, Z, Z, I, Z, 0.1, 0.01, bad_P);
+  assert(reject.status == Status::invalid_covariance); expect_noop(reject, bad_P);
+  bad_P = P; bad_P(0, 1) = 0.01;
+  reject = update_forward_velocity<N>(I, Z, Z, Z, I, Z, 0.1, 0.01, bad_P);
+  assert(reject.status == Status::invalid_covariance); expect_noop(reject, bad_P);
+  ++checks;
+
+  // 8. Cross-correlated priors never cause direct attitude/position/bias changes;
+  // frozen-state covariance remains unchanged, Joseph P is symmetric/PSD.
+  std::mt19937 rng(20260910);
+  std::normal_distribution<double> normal;
+  for (int trial = 0; trial < 100; ++trial) {
+    Mat m; for (int i = 0; i < N; ++i) for (int j = 0; j < N; ++j) m(i, j) = normal(rng);
+    Mat correlated = (m * m.transpose()) * 1e-3 + Mat::Identity() * 1e-6;
+    auto out = update_forward_velocity<N>(r, v, bg, gyro, rbi, lever,
+        model.predicted_mps + 0.02, 0.01, correlated, generous());
+    assert(out.accepted());
+    for (int i = 0; i < N; ++i) if (i < 12 || i > 14) {
+      assert(out.delta(i) == 0.0);
+      for (int j = 0; j < N; ++j) if (j < 12 || j > 14)
+        assert(std::abs(out.covariance(i, j) - correlated(i, j)) < 1e-12);
+    }
+    assert((out.covariance - out.covariance.transpose()).norm() < 1e-12);
+    Eigen::SelfAdjointEigenSolver<Mat> eigen(out.covariance);
+    assert(eigen.eigenvalues().minCoeff() > -1e-12);
+  }
+  ++checks;
+
+  // 9. Zero covariance is valid (wheel cannot manufacture confidence/motion).
+  auto zero = update_forward_velocity<N>(I, Z, Z, Z, I, Z, 0.01, 0.01, Mat::Zero());
+  assert(zero.accepted() && zero.delta.isZero(0.0) && zero.covariance.isZero(0.0));
+  ++checks;
+
+  // 10. Stationary observation does not arbitrarily flatten lateral/vertical v.
+  auto scalar = update_forward_velocity<N>(I, Vec(0.01, 0.02, -0.03), Z, Z,
+      I, Z, 0.0, 0.01, P);
+  assert(scalar.accepted());
+  assert(scalar.delta(13) == 0.0 && scalar.delta(14) == 0.0);
+  ++checks;
+
+  std::cout << "wheel forward-velocity tests: " << checks << "/" << checks << " passed\n";
+  return 0;
+}
diff --git a/include/state_aiding_safety.hpp b/include/state_aiding_safety.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..2227ad5f75d5e2504f5ae9ad29a3c0b0e4c25806
--- /dev/null
+++ b/include/state_aiding_safety.hpp
@@ -0,0 +1,334 @@
+#ifndef FAST_LIO_STATE_AIDING_SAFETY_HPP
+#define FAST_LIO_STATE_AIDING_SAFETY_HPP
+
+#include <Eigen/Cholesky>
+#include <Eigen/Core>
+#include <algorithm>
+#include <cmath>
+#include <limits>
+
+// ROS-free math used by the FAST-LIO integration.  State tangent order is:
+// pos 0, rot 3, extr_R 6, extr_T 9, vel 12, bg 15, ba 18, gravity 21.
+namespace fast_lio_safety {
+
+inline Eigen::Matrix3d skew(const Eigen::Vector3d &v) {
+  Eigen::Matrix3d result;
+  result << 0.0, -v.z(), v.y(), v.z(), 0.0, -v.x(), -v.y(), v.x(), 0.0;
+  return result;
+}
+
+inline bool is_rotation(const Eigen::Matrix3d &r) {
+  return r.allFinite() && std::abs(r.determinant() - 1.0) < 1.0e-6 &&
+      (r.transpose() * r - Eigen::Matrix3d::Identity()).norm() < 1.0e-6;
+}
+
+template<int N>
+bool valid_covariance(const Eigen::Matrix<double, N, N> &input) {
+  if (!input.allFinite()) return false;
+  const double scale = std::max(1.0, input.cwiseAbs().maxCoeff());
+  if ((input - input.transpose()).cwiseAbs().maxCoeff() > 1.0e-8 * scale)
+    return false;
+  const Eigen::Matrix<double, N, N> covariance =
+      0.5 * (input + input.transpose());
+  const Eigen::LDLT<Eigen::Matrix<double, N, N>> ldlt(covariance);
+  return ldlt.info() == Eigen::Success &&
+      ldlt.vectorD().minCoeff() >= -1.0e-12 * scale;
+}
+
+struct ZuptLimits {
+  double max_velocity_innovation_mps = 0.5;
+  double max_nis = 11.345;  // chi-square, three dimensions, 99 percent
+  double max_velocity_correction_mps = 0.1;
+};
+
+enum class ZuptStatus {
+  accepted,
+  invalid_input,
+  invalid_covariance,
+  innovation_limit,
+  nis_limit,
+  correction_limit
+};
+
+inline const char *status_name(ZuptStatus status) {
+  switch (status) {
+    case ZuptStatus::accepted: return "accepted";
+    case ZuptStatus::invalid_input: return "invalid_input";
+    case ZuptStatus::invalid_covariance: return "invalid_covariance";
+    case ZuptStatus::innovation_limit: return "innovation_limit";
+    case ZuptStatus::nis_limit: return "nis_limit";
+    case ZuptStatus::correction_limit: return "correction_limit";
+  }
+  return "unknown";
+}
+
+template<int N>
+struct ZuptResult {
+  ZuptStatus status = ZuptStatus::invalid_input;
+  double innovation_norm_mps = std::numeric_limits<double>::quiet_NaN();
+  double nis = std::numeric_limits<double>::quiet_NaN();
+  double velocity_correction_mps = 0.0;
+  Eigen::Matrix<double, N, 1> delta = Eigen::Matrix<double, N, 1>::Zero();
+  Eigen::Matrix<double, N, N> covariance;
+  bool accepted() const { return status == ZuptStatus::accepted; }
+};
+
+// A zero-velocity pseudo-measurement with a Schmidt-style constrained gain.
+// Only velocity rows of K are active.  Joseph form uses that same constrained
+// K, so the returned mean and covariance describe the same update.
+template<int N>
+ZuptResult<N> update_zero_velocity(
+    const Eigen::Vector3d &velocity, double measurement_variance,
+    const Eigen::Matrix<double, N, N> &prior,
+    const ZuptLimits &limits = ZuptLimits{}) {
+  static_assert(N >= 15, "FAST-LIO velocity block required");
+  ZuptResult<N> out;
+  out.covariance = prior;  // every rejection is an exact no-op
+  if (!velocity.allFinite() || !std::isfinite(measurement_variance) ||
+      measurement_variance <= 0.0 ||
+      !std::isfinite(limits.max_velocity_innovation_mps) ||
+      limits.max_velocity_innovation_mps <= 0.0 ||
+      !std::isfinite(limits.max_nis) || limits.max_nis <= 0.0 ||
+      !std::isfinite(limits.max_velocity_correction_mps) ||
+      limits.max_velocity_correction_mps <= 0.0) {
+    return out;
+  }
+  if (!valid_covariance(prior)) {
+    out.status = ZuptStatus::invalid_covariance;
+    return out;
+  }
+  const Eigen::Matrix<double, N, N> P = 0.5 * (prior + prior.transpose());
+  const Eigen::Vector3d innovation = -velocity;
+  out.innovation_norm_mps = innovation.norm();
+  if (!std::isfinite(out.innovation_norm_mps) ||
+      out.innovation_norm_mps > limits.max_velocity_innovation_mps) {
+    out.status = ZuptStatus::innovation_limit;
+    return out;
+  }
+  const Eigen::Matrix3d R = measurement_variance * Eigen::Matrix3d::Identity();
+  const Eigen::Matrix3d S = P.template block<3, 3>(12, 12) + R;
+  const Eigen::LDLT<Eigen::Matrix3d> solver(S);
+  if (solver.info() != Eigen::Success || solver.vectorD().minCoeff() <= 0.0) {
+    out.status = ZuptStatus::invalid_covariance;
+    return out;
+  }
+  const Eigen::Vector3d solved_innovation = solver.solve(innovation);
+  out.nis = innovation.dot(solved_innovation);
+  if (!std::isfinite(out.nis) || out.nis < 0.0 || out.nis > limits.max_nis) {
+    out.status = ZuptStatus::nis_limit;
+    return out;
+  }
+
+  Eigen::Matrix<double, 3, N> H = Eigen::Matrix<double, 3, N>::Zero();
+  H.template block<3, 3>(0, 12) = Eigen::Matrix3d::Identity();
+  Eigen::Matrix<double, N, 3> K = Eigen::Matrix<double, N, 3>::Zero();
+  K.template block<3, 3>(12, 0) =
+      P.template block<3, 3>(12, 12) *
+      solver.solve(Eigen::Matrix3d::Identity());
+  const Eigen::Vector3d delta_velocity =
+      K.template block<3, 3>(12, 0) * innovation;
+  out.velocity_correction_mps = delta_velocity.norm();
+  if (!delta_velocity.allFinite() ||
+      out.velocity_correction_mps > limits.max_velocity_correction_mps) {
+    out.status = ZuptStatus::correction_limit;
+    return out;
+  }
+  out.delta.template segment<3>(12) = delta_velocity;
+  const Eigen::Matrix<double, N, N> A =
+      Eigen::Matrix<double, N, N>::Identity() - K * H;
+  const Eigen::Matrix<double, N, N> posterior =
+      A * P * A.transpose() + K * R * K.transpose();
+  out.covariance = 0.5 * (posterior + posterior.transpose());
+  if (!valid_covariance(out.covariance)) {
+    out.covariance = prior;
+    out.delta.setZero();
+    out.status = ZuptStatus::invalid_covariance;
+    return out;
+  }
+  out.status = ZuptStatus::accepted;
+  return out;
+}
+
+template<int N>
+struct StateSnapshot {
+  Eigen::Vector3d position = Eigen::Vector3d::Zero();
+  Eigen::Matrix3d rotation = Eigen::Matrix3d::Identity();
+  Eigen::Matrix3d extrinsic_rotation = Eigen::Matrix3d::Identity();
+  Eigen::Vector3d extrinsic_translation = Eigen::Vector3d::Zero();
+  Eigen::Vector3d velocity = Eigen::Vector3d::Zero();
+  Eigen::Vector3d gyro_bias = Eigen::Vector3d::Zero();
+  Eigen::Vector3d accel_bias = Eigen::Vector3d::Zero();
+  Eigen::Vector3d gravity = Eigen::Vector3d::Zero();
+};
+
+struct GuardLimits {
+  double max_prediction_position_delta_m = 0.0;
+  double max_prediction_rotation_delta_deg = 0.0;
+  double max_prediction_velocity_delta_mps = 0.0;
+  double frozen_state_tolerance = 1.0e-10;
+};
+
+enum class GuardStatus {
+  accepted,
+  invalid_state,
+  invalid_covariance,
+  aid_modified_frozen_state,
+  correction_limit
+};
+
+template<int N>
+struct GuardResult {
+  GuardStatus status = GuardStatus::invalid_state;
+  double prediction_position_delta_m = 0.0;
+  double prediction_rotation_delta_deg = 0.0;
+  double prediction_velocity_delta_mps = 0.0;
+  double aid_position_delta_m = 0.0;
+  double aid_rotation_delta_deg = 0.0;
+  double aid_velocity_delta_mps = 0.0;
+  bool accepted() const { return status == GuardStatus::accepted; }
+};
+
+inline double rotation_delta_deg(const Eigen::Matrix3d &from,
+                                 const Eigen::Matrix3d &to) {
+  const Eigen::Matrix3d relative = from.transpose() * to;
+  const Eigen::Vector3d antisymmetric(
+      relative(2, 1) - relative(1, 2),
+      relative(0, 2) - relative(2, 0),
+      relative(1, 0) - relative(0, 1));
+  const double sine = 0.5 * antisymmetric.norm();
+  const double cosine = std::max(-1.0, std::min(
+      1.0, 0.5 * (relative.trace() - 1.0)));
+  return std::atan2(sine, cosine) * 180.0 /
+      3.14159265358979323846;
+}
+
+template<int N>
+GuardResult<N> validate_post_aid(
+    const StateSnapshot<N> &prediction, const StateSnapshot<N> &after_lidar,
+    const StateSnapshot<N> &final_state,
+    const Eigen::Matrix<double, N, N> &final_covariance,
+    const GuardLimits &limits) {
+  GuardResult<N> out;
+  const auto finite_snapshot = [](const StateSnapshot<N> &s) {
+    return s.position.allFinite() && s.velocity.allFinite() &&
+        s.gyro_bias.allFinite() && s.accel_bias.allFinite() &&
+        s.gravity.allFinite() && s.extrinsic_translation.allFinite() &&
+        is_rotation(s.rotation) && is_rotation(s.extrinsic_rotation);
+  };
+  if (!finite_snapshot(prediction) || !finite_snapshot(after_lidar) ||
+      !finite_snapshot(final_state)) return out;
+  if (!valid_covariance(final_covariance)) {
+    out.status = GuardStatus::invalid_covariance;
+    return out;
+  }
+  out.prediction_position_delta_m =
+      (final_state.position - prediction.position).norm();
+  out.prediction_rotation_delta_deg =
+      rotation_delta_deg(prediction.rotation, final_state.rotation);
+  out.prediction_velocity_delta_mps =
+      (final_state.velocity - prediction.velocity).norm();
+  out.aid_position_delta_m =
+      (final_state.position - after_lidar.position).norm();
+  out.aid_rotation_delta_deg =
+      rotation_delta_deg(after_lidar.rotation, final_state.rotation);
+  out.aid_velocity_delta_mps =
+      (final_state.velocity - after_lidar.velocity).norm();
+  const double frozen_delta = std::max({
+      out.aid_position_delta_m,
+      (final_state.rotation - after_lidar.rotation).norm(),
+      (final_state.extrinsic_rotation -
+       after_lidar.extrinsic_rotation).norm(),
+      (final_state.extrinsic_translation -
+       after_lidar.extrinsic_translation).norm(),
+      (final_state.gyro_bias - after_lidar.gyro_bias).norm(),
+      (final_state.accel_bias - after_lidar.accel_bias).norm(),
+      (final_state.gravity - after_lidar.gravity).norm()});
+  if (!std::isfinite(frozen_delta) || frozen_delta > limits.frozen_state_tolerance) {
+    out.status = GuardStatus::aid_modified_frozen_state;
+    return out;
+  }
+  if ((limits.max_prediction_position_delta_m > 0.0 &&
+       out.prediction_position_delta_m > limits.max_prediction_position_delta_m) ||
+      (limits.max_prediction_rotation_delta_deg > 0.0 &&
+       out.prediction_rotation_delta_deg > limits.max_prediction_rotation_delta_deg) ||
+      (limits.max_prediction_velocity_delta_mps > 0.0 &&
+       out.prediction_velocity_delta_mps > limits.max_prediction_velocity_delta_mps)) {
+    out.status = GuardStatus::correction_limit;
+    return out;
+  }
+  out.status = GuardStatus::accepted;
+  return out;
+}
+
+template<int N>
+struct BodyTwistResult {
+  bool valid = false;
+  Eigen::Vector3d linear = Eigen::Vector3d::Zero();
+  Eigen::Vector3d angular = Eigen::Vector3d::Zero();
+  Eigen::Matrix<double, 6, 6> covariance =
+      Eigen::Matrix<double, 6, 6>::Zero();
+};
+
+template<int N>
+struct PoseCovarianceResult {
+  bool valid = false;
+  Eigen::Matrix<double, 6, 6> covariance =
+      Eigen::Matrix<double, 6, 6>::Zero();
+};
+
+// PoseWithCovariance orders x/y/z then fixed-axis rotations about world X/Y/Z.
+// FAST-LIO stores position at tangent 0 and a right/body rotation perturbation
+// at tangent 3, so the small world rotation error is R_WB * delta_theta_body.
+template<int N>
+PoseCovarianceResult<N> pose_covariance_fixed_axis(
+    const Eigen::Matrix3d &R_WB,
+    const Eigen::Matrix<double, N, N> &state_covariance) {
+  static_assert(N >= 6, "FAST-LIO position and rotation blocks required");
+  PoseCovarianceResult<N> out;
+  if (!is_rotation(R_WB) || !valid_covariance(state_covariance)) return out;
+  Eigen::Matrix<double, 6, N> J = Eigen::Matrix<double, 6, N>::Zero();
+  J.template block<3, 3>(0, 0) = Eigen::Matrix3d::Identity();
+  J.template block<3, 3>(3, 3) = R_WB;
+  out.covariance = J * state_covariance * J.transpose();
+  out.covariance = 0.5 * (out.covariance + out.covariance.transpose());
+  out.valid = out.covariance.allFinite();
+  return out;
+}
+
+// nav_msgs/Odometry defines twist in child_frame_id.  FAST-LIO velocity is in
+// the world frame, while raw unbiased gyro is already in the IMU/body frame.
+template<int N>
+BodyTwistResult<N> body_twist(
+    const Eigen::Matrix3d &R_WB, const Eigen::Vector3d &velocity_world,
+    const Eigen::Vector3d &gyro_body, const Eigen::Vector3d &gyro_bias,
+    const Eigen::Matrix<double, N, N> &state_covariance,
+    const Eigen::Matrix3d &gyro_measurement_covariance) {
+  static_assert(N >= 18, "FAST-LIO velocity and gyro-bias blocks required");
+  BodyTwistResult<N> out;
+  if (!is_rotation(R_WB) || !velocity_world.allFinite() ||
+      !gyro_body.allFinite() || !gyro_bias.allFinite() ||
+      !valid_covariance(state_covariance) ||
+      !gyro_measurement_covariance.allFinite()) return out;
+  const Eigen::Matrix3d gyro_covariance =
+      0.5 * (gyro_measurement_covariance +
+             gyro_measurement_covariance.transpose());
+  Eigen::LDLT<Eigen::Matrix3d> gyro_ldlt(gyro_covariance);
+  if (gyro_ldlt.info() != Eigen::Success ||
+      gyro_ldlt.vectorD().minCoeff() < -1.0e-12) return out;
+  out.linear = R_WB.transpose() * velocity_world;
+  out.angular = gyro_body - gyro_bias;
+  Eigen::Matrix<double, 6, N> J = Eigen::Matrix<double, 6, N>::Zero();
+  J.template block<3, 3>(0, 3) = skew(out.linear);
+  J.template block<3, 3>(0, 12) = R_WB.transpose();
+  J.template block<3, 3>(3, 15) = -Eigen::Matrix3d::Identity();
+  out.covariance = J * state_covariance * J.transpose();
+  out.covariance.template block<3, 3>(3, 3) += gyro_covariance;
+  out.covariance = 0.5 * (out.covariance + out.covariance.transpose());
+  out.valid = out.linear.allFinite() && out.angular.allFinite() &&
+      out.covariance.allFinite();
+  return out;
+}
+
+}  // namespace fast_lio_safety
+
+#endif
diff --git a/tests/test_state_aiding_safety.cpp b/tests/test_state_aiding_safety.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..bd6ee97d057c2a1095422bb3c33aa084d8a1e8cf
--- /dev/null
+++ b/tests/test_state_aiding_safety.cpp
@@ -0,0 +1,119 @@
+#include "include/state_aiding_safety.hpp"
+
+#include <Eigen/Geometry>
+#include <cassert>
+#include <cmath>
+
+namespace {
+constexpr int N = 23;
+using Cov = Eigen::Matrix<double, N, N>;
+
+bool near(double a, double b, double tolerance = 1.0e-10) {
+  return std::abs(a - b) <= tolerance;
+}
+}  // namespace
+
+int main() {
+  Cov prior = 0.01 * Cov::Identity();
+  prior.block<3, 3>(0, 12) = 0.002 * Eigen::Matrix3d::Identity();
+  prior.block<3, 3>(12, 0) = 0.002 * Eigen::Matrix3d::Identity();
+  const auto accepted = fast_lio_safety::update_zero_velocity<N>(
+      Eigen::Vector3d(0.02, -0.01, 0.005), 0.001, prior);
+  assert(accepted.accepted());
+  assert(accepted.delta.segment<12>(0).isZero(0.0));
+  assert(accepted.delta.segment<N - 15>(15).isZero(0.0));
+  assert(accepted.delta.segment<3>(12).norm() > 0.0);
+  assert(fast_lio_safety::valid_covariance(accepted.covariance));
+
+  // Regression for the observed 2.319 m/s stationary innovation: reject it
+  // exactly, without a pose/attitude/bias/gravity mean change or covariance.
+  const auto observed_jump_case = fast_lio_safety::update_zero_velocity<N>(
+      Eigen::Vector3d(0.103117, -2.319210, -0.292385), 0.0001, prior);
+  assert(observed_jump_case.status ==
+         fast_lio_safety::ZuptStatus::innovation_limit);
+  assert(observed_jump_case.delta.isZero(0.0));
+  assert(observed_jump_case.covariance.isApprox(prior, 0.0));
+
+  Cov certain = 1.0e-6 * Cov::Identity();
+  const auto inconsistent = fast_lio_safety::update_zero_velocity<N>(
+      Eigen::Vector3d(0.01, 0.0, 0.0), 1.0e-6, certain);
+  assert(inconsistent.status == fast_lio_safety::ZuptStatus::nis_limit);
+
+  fast_lio_safety::ZuptLimits tight;
+  tight.max_nis = 100.0;
+  tight.max_velocity_correction_mps = 0.05;
+  const auto too_large = fast_lio_safety::update_zero_velocity<N>(
+      Eigen::Vector3d(0.2, 0.0, 0.0), 1.0e-6, prior, tight);
+  assert(too_large.status ==
+         fast_lio_safety::ZuptStatus::correction_limit);
+  assert(too_large.covariance.isApprox(prior, 0.0));
+
+  fast_lio_safety::StateSnapshot<N> prediction;
+  fast_lio_safety::StateSnapshot<N> lidar = prediction;
+  fast_lio_safety::StateSnapshot<N> final_state = lidar;
+  lidar.position.x() = 0.02;
+  final_state = lidar;
+  final_state.velocity.x() = 0.03;
+  fast_lio_safety::GuardLimits guard_limits;
+  guard_limits.max_prediction_position_delta_m = 0.05;
+  guard_limits.max_prediction_rotation_delta_deg = 2.0;
+  guard_limits.max_prediction_velocity_delta_mps = 0.1;
+  const auto guarded = fast_lio_safety::validate_post_aid<N>(
+      prediction, lidar, final_state, prior, guard_limits);
+  assert(guarded.accepted());
+  // Identical stored rotation matrices must count as exactly frozen even when
+  // trace/acos reports a tiny self-angle from orthogonality roundoff.
+  const Eigen::Matrix3d realistic_rotation =
+      Eigen::AngleAxisd(0.731, Eigen::Vector3d(0.2, -0.4, 0.7).normalized())
+          .toRotationMatrix();
+  prediction.rotation = realistic_rotation;
+  lidar.rotation = realistic_rotation;
+  final_state.rotation = realistic_rotation;
+  const auto identical_rotation = fast_lio_safety::validate_post_aid<N>(
+      prediction, lidar, final_state, prior, guard_limits);
+  assert(identical_rotation.accepted());
+  final_state.position.y() = 0.001;
+  const auto pose_jump = fast_lio_safety::validate_post_aid<N>(
+      prediction, lidar, final_state, prior, guard_limits);
+  assert(pose_jump.status ==
+         fast_lio_safety::GuardStatus::aid_modified_frozen_state);
+
+  const Eigen::Matrix3d R_WB =
+      Eigen::AngleAxisd(0.5 * 3.14159265358979323846,
+                        Eigen::Vector3d::UnitZ()).toRotationMatrix();
+  const auto twist = fast_lio_safety::body_twist<N>(
+      R_WB, Eigen::Vector3d::UnitX(), Eigen::Vector3d(0.1, 0.2, 0.3),
+      Eigen::Vector3d(0.01, 0.02, 0.03), prior,
+      0.001 * Eigen::Matrix3d::Identity());
+  assert(twist.valid);
+  assert(near(twist.linear.x(), 0.0));
+  assert(near(twist.linear.y(), -1.0));
+  assert(twist.angular.isApprox(Eigen::Vector3d(0.09, 0.18, 0.27)));
+  assert(twist.covariance.allFinite());
+  assert((twist.covariance - twist.covariance.transpose()).norm() < 1.0e-10);
+
+  Cov pose_state_covariance = 0.1 * Cov::Identity();
+  pose_state_covariance.block<3, 3>(0, 0) =
+      Eigen::Vector3d(1.0, 2.0, 3.0).asDiagonal();
+  pose_state_covariance.block<3, 3>(3, 3) =
+      Eigen::Vector3d(4.0, 5.0, 6.0).asDiagonal();
+  Eigen::Matrix3d position_rotation_cross;
+  position_rotation_cross <<
+      0.01, -0.02, 0.03,
+      0.02, 0.01, -0.01,
+      -0.01, 0.02, 0.01;
+  pose_state_covariance.block<3, 3>(0, 3) = position_rotation_cross;
+  pose_state_covariance.block<3, 3>(3, 0) =
+      position_rotation_cross.transpose();
+  const auto pose_covariance =
+      fast_lio_safety::pose_covariance_fixed_axis<N>(
+          R_WB, pose_state_covariance);
+  assert(pose_covariance.valid);
+  assert((pose_covariance.covariance.block<3, 3>(0, 0).isApprox(
+      pose_state_covariance.block<3, 3>(0, 0))));
+  assert((pose_covariance.covariance.block<3, 3>(3, 3).isApprox(
+      R_WB * pose_state_covariance.block<3, 3>(3, 3) * R_WB.transpose())));
+  assert((pose_covariance.covariance.block<3, 3>(0, 3).isApprox(
+      position_rotation_cross * R_WB.transpose())));
+  return 0;
+}
