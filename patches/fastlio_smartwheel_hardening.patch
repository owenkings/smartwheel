+
+// ZUPT support: track how long /wheel/odom has reported near-zero speed.
+// zlac8030_driver_node publishes this unconditionally (real encoder feedback
+// when feedback registers are configured, open-loop-from-command otherwise),
+// so "apparent zero" here means the base driver believes the wheels are not
+// turning - it does not by itself prove the chair is stationary (e.g. it
+// would miss the wheels being spun by an external push while under a
+// mismatched invert_left/invert_right sign). Combined with a hold_time_sec
+// debounce and a staleness timeout (see apply_zupt_if_stationary), this is a
+// deliberately conservative "safe to assume stationary" signal, not a
+// certified stationary detector.
+void wheel_odom_cbk(const nav_msgs::msg::Odometry::SharedPtr msg)
+{
+    double stamp = get_time_sec(msg->header.stamp);
+    bool apparent_zero = abs(msg->twist.twist.linear.x) < zupt_linear_speed_thresh &&
+                          abs(msg->twist.twist.angular.z) < zupt_angular_speed_thresh;
+
+    std::lock_guard<mutex> lock(mtx_buffer);
+    const bool feedback_health_fresh = zupt_feedback_health_receive_time >= 0.0 &&
+        steady_time_sec() - zupt_feedback_health_receive_time <=
+            zupt_feedback_health_timeout_sec;
+    const bool feedback_ok = !zupt_require_feedback_healthy ||
+        (feedback_health_fresh && zupt_feedback_healthy);
+    if (!zupt_odom_history.empty() && stamp < zupt_odom_history.back().stamp) {
+        // A replay/time reset invalidates the previous time-domain history.
+        zupt_odom_history.clear();
+        zupt_stationary_since = -1.0;
+        zupt_confirmed_stationary = false;
+    }
+    zupt_last_odom_stamp = stamp;
+    if (apparent_zero && feedback_ok) {
+        if (zupt_stationary_since < 0.0) {
+            zupt_stationary_since = stamp;
+        }
+        zupt_confirmed_stationary = (stamp - zupt_stationary_since) >= zupt_hold_time_sec;
+    } else {
+        zupt_stationary_since = -1.0;
+        zupt_confirmed_stationary = false;
+    }
+    zupt_odom_history.push_back({stamp, zupt_confirmed_stationary, feedback_ok});
+    while (!zupt_odom_history.empty() &&
+           stamp - zupt_odom_history.front().stamp > zupt_history_sec) {
+        zupt_odom_history.pop_front();
+    }
+}
