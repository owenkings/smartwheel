+
+// ZUPT support: track how long /wheel/odom has reported near-zero speed.
+// zlac8030_driver_node publishes this unconditionally (real encoder feedback
+// when feedback registers are configured, open-loop-from-command otherwise),
+// so "apparent zero" here means the base driver believes the wheels are not
+// turning - it does not by itself prove the chair is stationary (e.g. it
+// would miss the wheels being spun by an external push while under a
+// mismatched invert_left/invert_right sign). Combined with a hold_time_sec
+// debounce and a staleness timeout (see apply_zupt_if_stationary), this is a
+// deliberately conservative "safe to assume stationary" signal, not a
+// certified stationary detector.
+void wheel_odom_cbk(const nav_msgs::msg::Odometry::SharedPtr msg)
+{
+    double stamp = get_time_sec(msg->header.stamp);
+    if (!std::isfinite(stamp) || stamp <= 0.0 ||
+        !std::isfinite(msg->twist.twist.linear.x) ||
+        !std::isfinite(msg->twist.twist.angular.z)) return;
+    bool apparent_zero = abs(msg->twist.twist.linear.x) < zupt_linear_speed_thresh &&
+                          abs(msg->twist.twist.angular.z) < zupt_angular_speed_thresh;
+
+    std::lock_guard<mutex> lock(mtx_buffer);
+    const bool feedback_health_fresh = zupt_feedback_health_receive_time >= 0.0 &&
+        steady_time_sec() - zupt_feedback_health_receive_time <=
+            zupt_feedback_health_timeout_sec;
+    const bool feedback_ok = !zupt_require_feedback_healthy ||
+        (feedback_health_fresh && zupt_feedback_healthy);
+    if (wheel_update_en) {
+        // Time resets invalidate history. Equal stamps must not supply repeated
+        // independent measurements or shrink covariance multiple times.
+        if (!wheel_speed_history.empty() && stamp < wheel_speed_history.back().stamp) {
+            wheel_speed_history.clear();
+            wheel_update_last_used_stamp = -1.0;
+        }
+        if (wheel_speed_history.empty() || stamp > wheel_speed_history.back().stamp) {
+            const double variance = msg->twist.covariance[0];
+            const bool valid = msg->child_frame_id == wheel_update_frame &&
+                std::isfinite(variance) && variance > 0.0 &&
+                std::abs(msg->twist.twist.linear.x) <= wheel_update_max_speed_mps &&
+                feedback_health_fresh && zupt_feedback_healthy;
+            wheel_speed_history.push_back({stamp, msg->twist.twist.linear.x, variance, valid});
+            while (!wheel_speed_history.empty() &&
+                   stamp - wheel_speed_history.front().stamp > zupt_history_sec)
+                wheel_speed_history.pop_front();
+        }
+    }
+    if (!zupt_odom_history.empty() && stamp < zupt_odom_history.back().stamp) {
+        // A replay/time reset invalidates the previous time-domain history.
+        zupt_odom_history.clear();
+        zupt_stationary_since = -1.0;
+        zupt_confirmed_stationary = false;
+    }
+    zupt_last_odom_stamp = stamp;
+    if (apparent_zero && feedback_ok) {
+        if (zupt_stationary_since < 0.0) {
+            zupt_stationary_since = stamp;
+        }
+        zupt_confirmed_stationary = (stamp - zupt_stationary_since) >= zupt_hold_time_sec;
+    } else {
+        zupt_stationary_since = -1.0;
+        zupt_confirmed_stationary = false;
+    }
+    zupt_odom_history.push_back({stamp, zupt_confirmed_stationary, feedback_ok});
+    while (!zupt_odom_history.empty() &&
+           stamp - zupt_odom_history.front().stamp > zupt_history_sec) {
+        zupt_odom_history.pop_front();
+    }
+}
+
+// If ZUPT is enabled and /wheel/odom has confirmed the chair has been at
+// apparent-zero speed for at least hold_time_sec, apply a zero-velocity
+// pseudo-measurement so residual velocity error stops being integrated into
+// position drift every subsequent frame. No-op (and logs once) if /wheel/odom has
+// gone stale, so a dead odom topic fails closed to "do nothing" rather than
+// silently freezing velocity forever.
+void apply_zupt_if_stationary(double current_time)
+{
+    if (!zupt_en) return;
+
+    bool confirmed = false;
+    bool feedback_healthy = false;
+    bool sample_found = false;
+    double odom_age = -1.0;
+    bool imu_stationary = !zupt_require_imu_stationary;
+    bool imu_sample_found = !zupt_require_imu_stationary;
+    bool imu_window_covered = !zupt_require_imu_stationary;
+    double imu_age = -1.0;
+    bool live_feedback_healthy = !zupt_require_feedback_healthy;
+    double feedback_health_age = -1.0;
+    {
+        std::lock_guard<mutex> lock(mtx_buffer);
+        if (zupt_require_feedback_healthy && zupt_feedback_health_receive_time >= 0.0)
+        {
+            feedback_health_age = steady_time_sec() - zupt_feedback_health_receive_time;
+            live_feedback_healthy = zupt_feedback_healthy &&
+                feedback_health_age >= 0.0 &&
+                feedback_health_age <= zupt_feedback_health_timeout_sec;
+        }
+        // FAST-LIO may process an older LiDAR frame after a newer 50 Hz wheel
+        // sample has arrived. Selecting only the latest sample made age negative
+        // on 1171/1171 frames in the 2026-09-04 failure bag and silently disabled
+        // ZUPT. Select the newest wheel sample at or before the LiDAR time instead.
+        for (auto it = zupt_odom_history.rbegin(); it != zupt_odom_history.rend(); ++it) {
+            if (it->stamp <= current_time) {
+                confirmed = it->confirmed_stationary;
+                feedback_healthy = it->feedback_healthy;
+                odom_age = current_time - it->stamp;
+                sample_found = true;
+                break;
+            }
+        }
+        if (zupt_require_imu_stationary)
+        {
+            const double window_start = current_time - std::max(0.0, zupt_imu_window_sec);
+            bool latest_selected = false;
+            for (auto it = zupt_imu_history.rbegin(); it != zupt_imu_history.rend(); ++it)
+            {
+                if (it->stamp > current_time)
+                {
+                    continue;
+                }
+                if (!latest_selected)
+                {
+                    imu_age = current_time - it->stamp;
+                    imu_sample_found = true;
+                    imu_stationary = true;
+                    latest_selected = true;
+                }
+                if (it->stamp < window_start)
+                {
+                    imu_window_covered = true;
+                    break;
+                }
+                imu_stationary = imu_stationary && it->stationary;
+            }
+            if (zupt_imu_window_sec <= 0.0 && imu_sample_found)
+            {
+                imu_window_covered = true;
+            }
+        }
+    }
+
+    if (!sample_found || odom_age > zupt_stale_timeout_sec ||
+        (zupt_require_feedback_healthy &&
+         (!feedback_healthy || !live_feedback_healthy)) ||
+        !imu_sample_found || !imu_window_covered ||
+        (zupt_require_imu_stationary && imu_age > zupt_imu_stale_timeout_sec)) {
+        if (zupt_was_active) {
+            std::cout << "[ZUPT] prerequisites unavailable (odom_age=" << odom_age
+                      << "s, feedback_healthy=" << feedback_healthy
+                      << ", live_feedback_healthy=" << live_feedback_healthy
+                      << ", feedback_age=" << feedback_health_age
+                      << ", imu_age=" << imu_age
+                      << "s) - ZUPT suspended" << std::endl;
+            zupt_was_active = false;
+        }
+        return;
+    }
+    if (!confirmed || !imu_stationary) {
+        zupt_was_active = false;
+        return;
+    }
+
+    // Bounded zero-velocity pseudo-measurement.  A constrained Schmidt gain
+    // changes only velocity; pose, extrinsics, biases and gravity cannot jump
+    // through cross-covariance.  The helper applies innovation/NIS/correction
+    // gates and returns the matching Joseph-form covariance.
+    state_ikfom s = kf.get_x();
+    const auto update = fast_lio_safety::update_zero_velocity<state_ikfom::DOF>(
+        s.vel, std::max(1.0e-12, zupt_velocity_measurement_variance),
+        kf.get_P(), zupt_update_limits);
+    if (!update.accepted()) {
+        ++zupt_rejected_count;
+        if (zupt_was_active) {
+            std::cout << "[ZUPT] bounded update rejected ("
+                      << fast_lio_safety::status_name(update.status)
+                      << ", innovation=" << update.innovation_norm_mps
+                      << "m/s, NIS=" << update.nis << ") - ZUPT suspended"
+                      << std::endl;
+        }
+        zupt_was_active = false;
+        return;
+    }
+    s.vel += update.delta.template segment<3>(12);
+    kf.change_x(s);
+    auto covariance = update.covariance;
+    kf.change_P(covariance);
+    zupt_applied_count++;
+
+    if (!zupt_was_active) {
+        std::cout << "[ZUPT] confirmed stationary via " << zupt_wheel_odom_topic
+                  << " - applying zero-velocity pseudo-measurement" << std::endl;
+        zupt_was_active = true;
+    }
+}
+
+void apply_wheel_forward_speed(double current_time)
+{
+    if (!wheel_update_en) return;
+    WheelSpeedSample sample{};
+    bool found = false;
+    {
+        std::lock_guard<mutex> lock(mtx_buffer);
+        const double health_age = steady_time_sec() - zupt_feedback_health_receive_time;
+        if (!zupt_feedback_healthy || zupt_feedback_health_receive_time < 0.0 ||
+            health_age < 0.0 || health_age > zupt_feedback_health_timeout_sec) return;
+        for (auto it = wheel_speed_history.rbegin(); it != wheel_speed_history.rend(); ++it) {
+            if (it->stamp <= current_time) { sample = *it; found = true; break; }
+        }
+        if (!found || !sample.healthy ||
+            sample.stamp <= wheel_update_last_used_stamp ||
+            current_time - sample.stamp > wheel_update_max_age_sec) return;
+        wheel_update_last_used_stamp = sample.stamp;
+    }
+    // Use only a gyro sample at/before the cloud time for the IMU lever arm.
+    sensor_msgs::msg::Imu::ConstSharedPtr gyro_msg;
+    for (auto it = Measures.imu.rbegin(); it != Measures.imu.rend(); ++it) {
+        const double stamp = get_time_sec((*it)->header.stamp);
+        if (stamp <= current_time) { gyro_msg = *it; break; }
+    }
+    if (!gyro_msg || current_time - get_time_sec(gyro_msg->header.stamp) >
+            wheel_update_imu_max_age_sec) return;
+    auto s = kf.get_x();
+    const auto &w = gyro_msg->angular_velocity;
+    const Eigen::Vector3d gyro(w.x, w.y, w.z);
+    const auto result = fast_lio_wheel::update_forward_velocity<state_ikfom::DOF>(
+        s.rot.toRotationMatrix(), s.vel, s.bg, gyro, wheel_R_BI, wheel_t_BI,
+        sample.speed, std::max(wheel_update_variance_floor, sample.variance),
+        kf.get_P(), wheel_update_limits);
+    if (!result.accepted()) { ++wheel_updates_rejected; return; }
+    // Only velocity has a nonzero gain: no wheel pose/yaw overwrite and no
+    // direct correction of tilt, gravity, biases or uncalibrated extrinsics.
+    s.vel += result.delta.template segment<3>(12);
+    auto covariance = result.covariance;
+    kf.change_x(s);
+    kf.change_P(covariance);
+    ++wheel_updates_applied;
+}
