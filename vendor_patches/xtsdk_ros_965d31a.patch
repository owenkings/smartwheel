+CommnunicationNet::CommnunicationNet(boost::asio::io_service& ios,std::string& logtag)
+ :logtagname(logtag),socketTcp(ios),tcpEndpoint(tcp::v4(),7787),resolver(ios),socketUdp(ios),udpRecvBuffer(4096){}
+CommnunicationNet::~CommnunicationNet(){disconnect();closeUdp();}
+bool CommnunicationNet::connect(){
+ const std::lock_guard<std::mutex> lock(opencloseLock);
+ if(isConnected)return true;
+ if(!Utils::ipIsValid(address)||!Utils::ipIsValid(localBindIp))return false;
+ boost::system::error_code ec;
+ socketTcp.close(ec);socketTcp.open(tcp::v4(),ec);if(ec)return false;
+ socketTcp.bind(tcp::endpoint(boost::asio::ip::address_v4::from_string(localBindIp),0),ec);
+ if(ec){socketTcp.close(ec);return false;}
+ socketTcp.non_blocking(true,ec);if(ec){socketTcp.close(ec);return false;}
+ tcpEndpoint=tcp::endpoint(boost::asio::ip::address_v4::from_string(address),7787);
+ socketTcp.connect(tcpEndpoint,ec);
+ if(ec==boost::asio::error::in_progress||ec==boost::asio::error::would_block){
+   pollfd descriptor{socketTcp.native_handle(),POLLOUT,0};int error=0;socklen_t n=sizeof(error);
+   if(::poll(&descriptor,1,2500)<=0||::getsockopt(descriptor.fd,SOL_SOCKET,SO_ERROR,&error,&n)||error){socketTcp.close(ec);return false;}
+   ec.clear();
+ }
+ if(ec){socketTcp.close(ec);return false;}
+ isConnected=true;tcpRecvPacket.clear();return true;
+}
+void CommnunicationNet::disconnect(){
+ const std::lock_guard<std::mutex> lock(opencloseLock);isConnected=false;
+ boost::system::error_code ec;socketTcp.shutdown(tcp::socket::shutdown_both,ec);socketTcp.close(ec);
+}
+bool CommnunicationNet::openUdp(uint16_t port){
+ const std::lock_guard<std::mutex> lock(opencloseLock);
+ if(isUdpOpened)return true;
+ if(!Utils::ipIsValid(localBindIp)||localBindIp=="0.0.0.0"||!port)return false;
+ boost::system::error_code ec;socketUdp.close(ec);socketUdp.open(udp::v4(),ec);if(ec)return false;
+ // No SO_REUSEADDR: each process exclusively owns one concrete receive IP.
+ socketUdp.bind(udp::endpoint(boost::asio::ip::address_v4::from_string(localBindIp),port),ec);
+ if(ec){socketUdp.close(ec);return false;}
+ socketUdp.non_blocking(true,ec);if(ec){socketUdp.close(ec);return false;}
+ assembler_.reset();isUdpOpened=true;return true;
+}
+void CommnunicationNet::closeUdp(){
+ const std::lock_guard<std::mutex> lock(opencloseLock);isUdpOpened=false;
+ boost::system::error_code ec;socketUdp.cancel(ec);socketUdp.close(ec);
+}
+bool CommnunicationNet::transmitPackage(XByteArray data){
+ if(!isConnected)return false;boost::system::error_code ec;
+ const auto n=boost::asio::write(socketTcp,boost::asio::buffer(data),ec);
+ if(ec||n!=data.size()){disconnect();return false;}return true;
+}
+bool CommnunicationNet::receivePackage(XByteArray& package){
+ if(!isConnected)return false;
+ auto extract=[&](){
+   const uint8_t magic[]={0x7e,0xff,0xaa,0x55};
+   while(tcpRecvPacket.size()>=12){
+     const auto begin=std::search(tcpRecvPacket.begin(),tcpRecvPacket.end(),magic,magic+4);
+     if(begin==tcpRecvPacket.end()){tcpRecvPacket.erase(tcpRecvPacket.begin(),tcpRecvPacket.end()-3);return false;}
+     tcpRecvPacket.erase(tcpRecvPacket.begin(),begin);if(tcpRecvPacket.size()<12)return false;
+     const size_t n=Utils::getValueUint32Endian(&tcpRecvPacket[4],endianType);
+     if(n<3||n>65536){tcpRecvPacket.erase(tcpRecvPacket.begin());continue;}
+     if(tcpRecvPacket.size()<n+12)return false;
+     if(Utils::getValueUint32Endian(&tcpRecvPacket[n+8],Endian_Big)!=0xff7e55aa){tcpRecvPacket.erase(tcpRecvPacket.begin());continue;}
+     package.assign(tcpRecvPacket.begin()+8,tcpRecvPacket.begin()+n+8);
+     tcpRecvPacket.erase(tcpRecvPacket.begin(),tcpRecvPacket.begin()+n+12);return true;
+   }return false;
+ };
+ if(extract())return true;
+ uint8_t buffer[4096];boost::system::error_code ec;
+ const auto n=socketTcp.read_some(boost::asio::buffer(buffer),ec);
+ if(ec==boost::asio::error::would_block||ec==boost::asio::error::try_again){std::this_thread::sleep_for(std::chrono::milliseconds(2));return false;}
+ if(ec){disconnect();return false;}
+ if(tcpRecvPacket.size()+n>131072){tcpRecvPacket.clear();return false;}
+ tcpRecvPacket.insert(tcpRecvPacket.end(),buffer,buffer+n);return extract();
+}
+bool CommnunicationNet::udpReceiveFrame(XByteArray& package){
+ if(!isUdpOpened)return false;udp::endpoint source;boost::system::error_code ec;
+ const auto n=socketUdp.receive_from(boost::asio::buffer(udpRecvBuffer),source,0,ec);
+ if(ec==boost::asio::error::would_block||ec==boost::asio::error::try_again){std::this_thread::sleep_for(std::chrono::milliseconds(2));return false;}
+ if(ec||source.address().to_string()!=address)return false;
+ const XByteArray actual(udpRecvBuffer.begin(),udpRecvBuffer.begin()+n);return udppacket(actual,package);
+}
+bool CommnunicationNet::udppacket(const XByteArray& p,XByteArray& package){return assembler_.feed(p,endianType==Endian_Little,package);}
+}
