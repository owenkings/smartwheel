new file mode 100644
--- /dev/null
+++ b/xtsdk_cpp/xtsdk/wc_frame_storage.h
@@ -0,0 +1,30 @@
+#pragma once
+#include "frame.h"
+#include <limits>
+#include <type_traits>
+#include <stdexcept>
+namespace XinTan {
+// Conservatively accounts vector allocations, strings and map nodes owned by
+// this frame; allocator metadata is not included. Queue budgets are payload
+// budgets, not a claim about total process RSS. Nested raw sample counted once.
+inline size_t wc_frame_storage_bytes(const Frame& f,bool include_raw=true) {
+  size_t bytes=sizeof(Frame);
+  auto add=[&](size_t n){if(n>std::numeric_limits<size_t>::max()-bytes)
+      throw std::overflow_error("frame storage byte overflow");bytes+=n;};
+  auto vector=[&](const auto& v){add(v.capacity()*sizeof(typename std::decay_t<decltype(v)>::value_type));};
+  vector(f.frameData);vector(f.leveldata);vector(f.dcsdata);vector(f.rawdistData);
+  vector(f.distData);vector(f.amplData);vector(f.grayscaledata);vector(f.reflectivity);
+  vector(f.freqMap);vector(f.intMap);vector(f.points);vector(f.motion_vec);
+  add(f.frame_label.capacity()+1);
+  add(f.devsdk_feq_map.bucket_count()*sizeof(void*)+f.devsdk_feq_map.size()*(sizeof(void*)*2+sizeof(std::pair<const uint8_t,uint8_t>)));
+  if(include_raw && f.wc_before_host_filter)add(wc_frame_storage_bytes(*f.wc_before_host_filter,false));
+  return bytes;
+}
+inline std::shared_ptr<Frame> wc_copy_frame_pair(const std::shared_ptr<Frame>& f) {
+  if(!f || !f->wc_before_host_filter)throw std::invalid_argument("paired raw frame required");
+  auto copy=std::make_shared<Frame>(*f);
+  copy->wc_before_host_filter=std::make_shared<Frame>(*f->wc_before_host_filter);
+  copy->wc_before_host_filter->wc_before_host_filter.reset();
+  return copy;
+}
+}
