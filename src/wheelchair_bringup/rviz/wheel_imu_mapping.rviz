# Wheel/IMU-primary planar indoor mapping. Raw cloud retains full 3D XYZI.
# FAST-LIO shadow outputs never drive these displays. RTAB owns map->odom.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Live Right XYZI (Wheel TF)1
      Splitter Ratio: 0.5
    Tree Height: 360
  - Class: rviz_common/Views
    Name: Views
  # Dock name matches the reused QMainWindow State. Class/Topic are unchanged:
  # this is the W/A/S/D panel that feeds safety_supervisor on /cmd_vel_nav.
  - Angular: 0.5
    Class: wheelchair_bringup/TeleopPanel
    Linear: 0.1
    Name: SmartWheel Teleop
    EnablePushMode: true
    Topic: /cmd_vel_nav
  # Four camera views over compressed transport (see note 1 above).
  - CameraInfoTopic: /camera/front/camera_info
    Class: SmartWheel/Camera
    DetailsExpanded: false
    ImageTopic: /camera/front/image_raw
    KeepAspectRatio: true
    MaxDisplayFps: 10.0
    Mirror: false
    Name: Left-Side Camera
    PhysicalLabel: Left-Side Camera
    OfflineThresholdSec: 2.0
    RotationDegrees: 180
    ShowFps: true
    ShowTimestamp: true
    TransportHint: compressed
  - CameraInfoTopic: /camera/left/camera_info
    Class: SmartWheel/Camera
    DetailsExpanded: false
    ImageTopic: /camera/left/image_raw
    KeepAspectRatio: true
    MaxDisplayFps: 10.0
    Mirror: false
    Name: Left-Front Camera
    PhysicalLabel: Left-Front Camera
    OfflineThresholdSec: 2.0
    RotationDegrees: 180
    ShowFps: true
    ShowTimestamp: true
    TransportHint: compressed
  - CameraInfoTopic: /camera/right/camera_info
    Class: SmartWheel/Camera
    DetailsExpanded: false
    ImageTopic: /camera/right/image_raw
    KeepAspectRatio: true
    MaxDisplayFps: 10.0
    Mirror: false
    Name: Right-Front Camera
    PhysicalLabel: Right-Front Camera
    OfflineThresholdSec: 2.0
    RotationDegrees: 180
    ShowFps: true
    ShowTimestamp: true
    TransportHint: compressed
  - CameraInfoTopic: /camera/rear/camera_info
    Class: SmartWheel/Camera
    DetailsExpanded: false
    ImageTopic: /camera/rear/image_raw
    KeepAspectRatio: true
    MaxDisplayFps: 10.0
    Mirror: false
    Name: Right-Side Camera
    PhysicalLabel: Right-Side Camera
    OfflineThresholdSec: 2.0
    RotationDegrees: 180
    ShowFps: true
    ShowTimestamp: true
    TransportHint: compressed
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      Visual Enabled: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.6
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true
    # Latest raw XYZI, transformed using same-stamp wheel/IMU pose; no LIO pose.
    - Alpha: 1
      Autocompute Intensity Bounds: false
      Min Intensity: 50
      Max Intensity: 1600
      Autocompute Value Bounds:
        Max Value: 3
        Min Value: -1
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: Intensity
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: Live Right XYZI (Wheel TF)
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.03
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /wheel_mapping/cloud_registered
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    # Full XYZ/intensity scans placed by optimized graph poses, not the 2D grid's cloud product.
    - Alpha: 0.55
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: FlatColor
      Color: 160; 175; 190
      Position Transformer: XYZ
      Decay Time: 0
      Enabled: true
      Name: RTAB Optimized 3D XYZI Map
      Size (Pixels): 2
      Size (m): 0.025
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rtabmap/optimized_cloud
      Use Fixed Frame: true
      Value: true
    # 2D grid is a preview projected from RTAB's 3D observations, not Nav2 acceptance.
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: 2D Occupancy Grid
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rtabmap/grid_map
      Value: true
    # Merged navigation LaserScan.
    - Alpha: 1
      Autocompute Intensity Bounds: false
      Min Intensity: 50
      Max Intensity: 1600
      Class: rviz_default_plugins/LaserScan
      Color: 255; 80; 80
      Color Transformer: Intensity
      Decay Time: 0
      Enabled: true
      Name: LaserScan
      Position Transformer: XYZ
      Size (Pixels): 3
      Size (m): 0.02
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Use Fixed Frame: true
      Value: true
    # Continuous wheel/IMU odometry + trajectory; never the shadow LIO path.
    - Angle Tolerance: 0.1
      Class: rviz_default_plugins/Odometry
      Covariance:
        Value: false
      Enabled: true
      Keep: 1
      Name: Wheel IMU Odometry
      Position Tolerance: 0.1
      Shape:
        Alpha: 1
        Axes Length: 0.5
        Axes Radius: 0.05
        Color: 255; 25; 0
        Head Length: 0.2
        Head Radius: 0.1
        Shaft Length: 0.5
        Shaft Radius: 0.03
        Value: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /wheel_mapping/odometry_gated
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 200; 255
      Enabled: true
      Line Style: Lines
      Name: Wheel IMU Path
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /wheel_mapping/path
      Value: true
    # Camera views are SmartWheel/Camera PANELS (compressed) declared in the
    # Panels section above, not Image displays here. Adding
    # rviz_default_plugins/Image back would reintroduce raw subscribers and the
    # four-stream collapse described at the top of this file.
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    # Continuous frame avoids displaying loop-closure corrections as vehicle jumps.
    # RTAB map cloud/grid are transformed from map through its map->odom edge.
    Fixed Frame: odom
    Frame Rate: 15
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.6
      Target Frame: base_link
      Value: Orbit (rviz_default_plugins)
      Yaw: 1.0
    Saved:
      - Class: rviz_default_plugins/TopDownOrtho
        Name: TopDown
        Near Clip Distance: 0.01
        Scale: 30
        Target Frame: base_link
        Value: TopDownOrtho (rviz_default_plugins)
        X: 0
        Y: 0
Window Geometry:
  Displays:
    collapsed: false
  Left-Side Camera:
    collapsed: false
  Height: 1080
  Hide Left Dock: false
  Hide Right Dock: false
  Left-Front Camera:
    collapsed: false
  QMainWindow State: 
  Right-Side Camera:
    collapsed: false
  Right-Front Camera:
    collapsed: false
  SmartWheel Teleop:
    collapsed: false
  Views:
    collapsed: false
  Width: 1920
  X: 0
  Y: 0
