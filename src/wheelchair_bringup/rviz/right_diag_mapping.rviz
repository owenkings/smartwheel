# RViz layout for the right-radar DIAGNOSTIC mapping route
# (launch/right_lidar_diag_mapping.launch.py).
#
# FAST-LIO 3D cloud + 2D grid + merged scan + odometry/path + four camera views
# + W/A/S/D teleop.
#
# TWO THINGS THIS FIXES vs manual_mapping_lio_right.rviz
# ------------------------------------------------------
# 1. Camera transport. manual_mapping_lio_right.rviz uses
#    rviz_default_plugins/Image, which subscribes to RAW. Measured in
#    docs/hardware/CAMERA_ARRAY_B4_REPORT.md, raw delivers only 0.67-0.73 Hz per
#    topic, and that document states the four-view workbench must select
#    compressed. Driving four raw streams also forces the adapter to decode
#    MJPEG -> BGR for every frame and push ~230 kB/frame through DDS; measured
#    result was 2.6-9 Hz with two of four streams not coming up at all, and in
#    one session a UVC/USB link reset on the right-side unit.
#    Measured on compressed instead (auto_test/20260903_173000_right_diag_route/
#    compressed_four.txt): front 29.9, left 29.0, right 23.1, rear 25.0 Hz
#    sequentially and 28.9 / 27.9 / 22.2 / 24.0 Hz with all four subscribed at
#    once. So this layout uses the project's own SmartWheel/Camera panels with
#    TransportHint: compressed, matching the reviewed
#    hardware_operator_workbench.rviz.
#
# 2. Dock sizing. manual_mapping_lio_right.rviz declares only
#    Height/Width/Hide*Dock, leaving Qt to size the docks. With Displays/Views
#    holding a large minimum height, the camera docks collapse to zero height -
#    title bars visible, image never. The QMainWindow State below is the reviewed
#    workbench layout (179 px per camera dock). Reusing it requires matching dock
#    names, hence "<Side> Camera" and "SmartWheel Teleop" (the teleop panel is
#    still wheelchair_bringup/TeleopPanel on /cmd_vel_nav - only the dock name is
#    aligned). The state also names "SmartWheel System Status" and
#    "SmartWheel 2D Map" docks that this layout omits; Qt ignores missing docks.
#
# Layout: left  = Left Camera, Front Camera, tabbed(Teleop/Displays/Views)
#         right = Right Camera, Rear Camera
#         centre = 3D view
#
# Slot names are compatibility labels, not directions (camera_quad.yaml):
#   left -> left-front, right -> right-front, front -> left-side, rear -> right-side
# PhysicalLabel below carries the real position; RotationDegrees matches the
# per-role rotation in camera_quad.yaml.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /LIO 3D Cloud Map1
      Splitter Ratio: 0.5
    Tree Height: 360
  - Class: rviz_common/Views
    Name: Views
  # Dock name matches the reused QMainWindow State. Class/Topic are unchanged:
  # this is the W/A/S/D panel that feeds safety_supervisor on /cmd_vel_nav.
  - Angular: 0.5
    Class: wheelchair_bringup/TeleopPanel
    Linear: 0.1
    Name: SmartWheel Teleop
    Topic: /cmd_vel_nav
  # Four camera views over compressed transport (see note 1 above).
  - CameraInfoTopic: /camera/front/camera_info
    Class: SmartWheel/Camera
    DetailsExpanded: false
    ImageTopic: /camera/front/image_raw
    KeepAspectRatio: true
    MaxDisplayFps: 10.0
    Mirror: false
    Name: Left-Side Camera
    PhysicalLabel: Left-Side Camera
    OfflineThresholdSec: 2.0
    RotationDegrees: 180
    ShowFps: true
    ShowTimestamp: true
    TransportHint: compressed
  - CameraInfoTopic: /camera/left/camera_info
    Class: SmartWheel/Camera
    DetailsExpanded: false
    ImageTopic: /camera/left/image_raw
    KeepAspectRatio: true
    MaxDisplayFps: 10.0
    Mirror: false
    Name: Left-Front Camera
    PhysicalLabel: Left-Front Camera
    OfflineThresholdSec: 2.0
    RotationDegrees: 180
    ShowFps: true
    ShowTimestamp: true
    TransportHint: compressed
  - CameraInfoTopic: /camera/right/camera_info
    Class: SmartWheel/Camera
    DetailsExpanded: false
    ImageTopic: /camera/right/image_raw
    KeepAspectRatio: true
    MaxDisplayFps: 10.0
    Mirror: false
    Name: Right-Front Camera
    PhysicalLabel: Right-Front Camera
    OfflineThresholdSec: 2.0
    RotationDegrees: 180
    ShowFps: true
    ShowTimestamp: true
    TransportHint: compressed
  - CameraInfoTopic: /camera/rear/camera_info
    Class: SmartWheel/Camera
    DetailsExpanded: false
    ImageTopic: /camera/rear/image_raw
    KeepAspectRatio: true
    MaxDisplayFps: 10.0
    Mirror: false
    Name: Right-Side Camera
    PhysicalLabel: Right-Side Camera
    OfflineThresholdSec: 2.0
    RotationDegrees: 180
    ShowFps: true
    ShowTimestamp: true
    TransportHint: compressed
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      Visual Enabled: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.6
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true
    # FAST-LIO accumulated 3D map (registered cloud, in camera_init world frame).
    # Decay Time 0: FAST-LIO maintains the accumulated map itself; RViz decay is
    # NOT used to pile frames (that produced the old 'swirl'). AxisColor by Z.
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 3
        Min Value: -1
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: LIO 3D Cloud Map
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.03
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /cloud_registered
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    # 2D occupancy grid projected from the 3D cloud (Nav2).
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: 2D Occupancy Grid
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map_2d_from_3d
      Value: true
    # Merged navigation LaserScan.
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/LaserScan
      Color: 255; 80; 80
      Color Transformer: Intensity
      Decay Time: 0
      Enabled: true
      Name: LaserScan
      Position Transformer: XYZ
      Size (Pixels): 3
      Size (m): 0.02
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Use Fixed Frame: true
      Value: true
    # FAST-LIO odometry + trajectory path.
    - Angle Tolerance: 0.1
      Class: rviz_default_plugins/Odometry
      Covariance:
        Value: false
      Enabled: true
      Keep: 1
      Name: LIO Odometry
      Position Tolerance: 0.1
      Shape:
        Alpha: 1
        Axes Length: 0.5
        Axes Radius: 0.05
        Color: 255; 25; 0
        Head Length: 0.2
        Head Radius: 0.1
        Shaft Length: 0.5
        Shaft Radius: 0.03
        Value: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /Odometry
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 200; 255
      Enabled: true
      Line Style: Lines
      Name: LIO Path
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /path
      Value: true
    # Camera views are SmartWheel/Camera PANELS (compressed) declared in the
    # Panels section above, not Image displays here. Adding
    # rviz_default_plugins/Image back would reintroduce raw subscribers and the
    # four-stream collapse described at the top of this file.
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: camera_init
    Frame Rate: 15
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.6
      Target Frame: base_link
      Value: Orbit (rviz_default_plugins)
      Yaw: 1.0
    Saved:
      - Class: rviz_default_plugins/TopDownOrtho
        Name: TopDown
        Near Clip Distance: 0.01
        Scale: 30
        Target Frame: base_link
        Value: TopDownOrtho (rviz_default_plugins)
        X: 0
        Y: 0
Window Geometry:
  Displays:
    collapsed: false
  Left-Side Camera:
    collapsed: false
  Height: 1080
  Hide Left Dock: false
  Hide Right Dock: false
  Left-Front Camera:
    collapsed: false
  QMainWindow State: 
  Right-Side Camera:
    collapsed: false
  Right-Front Camera:
    collapsed: false
  SmartWheel Teleop:
    collapsed: false
  Views:
    collapsed: false
  Width: 1920
  X: 0
  Y: 0
