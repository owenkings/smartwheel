<?xml version="1.0"?>
<package format="3">
  <name>smartwheel_map_products</name>
  <version>0.1.0</version>
  <description>Map accumulation, ray-cast occupancy, offline colorization, and export.</description>
  <maintainer email="todo@example.com">SmartWheel team</maintainer>
