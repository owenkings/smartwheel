<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="indoor_autonomous_wheelchair">
  <!--
    Coordinate convention:
      base_link: X forward, Y left, Z up.
      map -> odom is published by SLAM/localization.
      odom -> base_link comes from wheel odom, EKF, or mock odom.
      base_link -> sensor frames are fixed joints from this URDF.

    The sensor positions below are first estimates only. Measure the real
    hardware and verify each frame in RViz before passenger testing.
  -->

  <xacro:property name="base_length" value="0.95"/>
  <xacro:property name="base_width" value="0.62"/>
  <xacro:property name="base_height" value="0.22"/>
  <xacro:property name="wheel_radius" value="0.16"/>
  <xacro:property name="wheel_width" value="0.05"/>
  <!-- Fail closed: the right-LiDAR calibration contract has no approved
       runtime transform. Synthetic tests may opt in explicitly, but the
       default robot model must not publish this provisional TF. -->
  <xacro:arg name="include_blocked_right_lidar_for_mock" default="false"/>
  <!-- Explicit real-data diagnostic opt-in; never makes the formal contract
       APPROVED. Both radar translations come from one measured-layout profile.
       The existing mock-only fixture remains unchanged for synthetic tests. -->
  <xacro:arg name="diagnostic_measured_layout" default="false"/>
  <xacro:arg name="diagnostic_layout_profile" default="$(find wheelchair_description)/config/diagnostic_measured_layout.yaml"/>
  <xacro:property name="diag_layout" value="${xacro.load_yaml('$(arg diagnostic_layout_profile)')}"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="base_blue">
        <color rgba="0.1 0.24 0.55 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
  </link>

  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="dark">
        <color rgba="0.02 0.02 0.02 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="left_wheel_fixed_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.34 0.16" rpy="0 0 0"/>
  </joint>

  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="right_wheel_fixed_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.34 0.16" rpy="0 0 0"/>
  </joint>

  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.06 0.04"/>
      </geometry>
      <material name="laser_red">
        <color rgba="0.75 0.05 0.05 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="laser_fixed_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.45 0.0 0.65" rpy="0.0 -0.0873 0.0"/>
  </joint>

  <!-- XT-M60 SDK coordinates are +z forward, +x left and +y up. The historical
       ground_plane_calibrator source/executable is absent from this branch, so
       robot_state_publisher is the single TF owner again. Lateral separation
       (~0.60 m) and optical-centre height (0.735 m) are user measurements;
       x=0.45 m remains the previous unverified longitudinal estimate. -->
  <xacro:macro name="xtm60_link" params="name xyz rpy">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.037 0.075 0.055"/>
        </geometry>
        <material name="laser_red"/>
      </visual>
    </link>
    <joint name="${name}_fixed_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <!-- Left roll/pitch retains the last reliable floor-visible calibration from
       feature/fastlio-narrow-fov-mapping (45b1163); current left floor fitting
       selected a non-floor surface, so it was not used to overwrite this. -->
  <xacro:unless value="$(arg diagnostic_measured_layout)">
    <xacro:xtm60_link
      name="xtm60_left_link"
      xyz="0.45 0.30 0.735"
      rpy="1.5515153364 -0.0136154207 1.5709313394"/>

    <xacro:if value="$(arg include_blocked_right_lidar_for_mock)">
    <!-- MOCK-ONLY historical candidate. It is not runtime-eligible for real
         hardware: longitudinal x/yaw are uncalibrated and the strict contract
         remains BLOCKED_CONFLICT. Keep it available only so synthetic
         right-frame tests can exercise the graph without claiming approval. -->
    <xacro:xtm60_link
      name="xtm60_right_link"
      xyz="0.606 -0.24 0.499"
      rpy="1.5806995918 0.1564194958 1.5715764604"/>
    </xacro:if>
  </xacro:unless>
  <xacro:if value="$(arg diagnostic_measured_layout)">
    <xacro:xtm60_link name="xtm60_left_link"
      xyz="${' '.join(map(str, diag_layout['sensors']['left']['xyz']))}"
      rpy="${' '.join(map(str, diag_layout['sensors']['left']['rpy']))}"/>
    <xacro:xtm60_link name="xtm60_right_link"
      xyz="${' '.join(map(str, diag_layout['sensors']['right']['xyz']))}"
      rpy="${' '.join(map(str, diag_layout['sensors']['right']['rpy']))}"/>
  </xacro:if>

  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.02"/>
      </geometry>
      <material name="imu_green">
        <color rgba="0.05 0.55 0.2 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="imu_fixed_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <!-- Roll/pitch from the 2026-07-22 user-confirmed level 60 s gravity
         capture. Yaw and xyz remain uncalibrated estimates. -->
    <xacro:unless value="$(arg diagnostic_measured_layout)">
      <origin xyz="0.0 0.0 0.45" rpy="0.0098981264 0.0011002597 0.0"/>
    </xacro:unless>
    <xacro:if value="$(arg diagnostic_measured_layout)">
      <origin xyz="${' '.join(map(str, diag_layout['sensors']['imu']['xyz']))}"
        rpy="${' '.join(map(str, diag_layout['sensors']['imu']['rpy']))}"/>
    </xacro:if>
  </joint>

  <xacro:macro name="camera_link" params="name xyz rpy">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.045 0.08 0.035"/>
        </geometry>
        <material name="camera_black">
          <color rgba="0.02 0.02 0.02 1.0"/>
        </material>
      </visual>
    </link>
    <joint name="${name}_fixed_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <xacro:camera_link name="camera_front_link" xyz="0.40 0.0 0.80" rpy="0.0 0.0 0.0"/>
  <xacro:camera_link name="camera_left_link" xyz="0.0 0.32 0.75" rpy="0.0 0.0 1.5708"/>
  <xacro:camera_link name="camera_right_link" xyz="0.0 -0.32 0.75" rpy="0.0 0.0 -1.5708"/>
  <xacro:camera_link name="camera_rear_link" xyz="-0.45 0.0 0.75" rpy="0.0 0.0 3.1416"/>

  <xacro:macro name="ultrasonic_link" params="idx xyz rpy">
    <link name="ultrasonic_${idx}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.025" length="0.02"/>
        </geometry>
        <material name="ultra_orange">
          <color rgba="0.95 0.42 0.04 1.0"/>
        </material>
      </visual>
    </link>
    <joint name="ultrasonic_${idx}_fixed_joint" type="fixed">
      <parent link="base_link"/>
      <child link="ultrasonic_${idx}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <!-- 4 active RS485 ultrasonics on one bus: range_0=left-front, range_1=left,
       range_2=right-front, range_3=right. xyz/rpy are estimates - MEASURE on the
       real chassis. idx 4,5 are reserved/unused. -->
  <xacro:ultrasonic_link idx="0" xyz="0.45 0.22 0.25" rpy="0.0 0.0 0.35"/>
  <xacro:ultrasonic_link idx="1" xyz="0.15 0.30 0.25" rpy="0.0 0.0 1.5708"/>
  <xacro:ultrasonic_link idx="2" xyz="0.45 -0.22 0.25" rpy="0.0 0.0 -0.35"/>
  <xacro:ultrasonic_link idx="3" xyz="0.15 -0.30 0.25" rpy="0.0 0.0 -1.5708"/>
  <xacro:ultrasonic_link idx="4" xyz="-0.45 0.0 0.25" rpy="0.0 0.0 3.1416"/>
  <xacro:ultrasonic_link idx="5" xyz="-0.35 -0.25 0.25" rpy="0.0 0.0 -2.62"/>
</robot>
